{
  "name": "@trokky/i18n",
  "version": "0.1.6",
  "description": "Internationalization support for Trokky CMS",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./locales/*": "./locales/*"
  },
  "files": [
    "dist",
    "locales"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "test": "echo 'No tests configured for this package' && exit 0",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@trokky/types": "^0.1.3",
    "i18next": "^24.2.2",
    "react-i18next": "^15.4.1",
    "i18next-browser-languagedetector": "^8.0.4"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "trokky",
    "cms",
    "i18n",
    "internationalization",
    "localization",
    "react"
  ],
  "author": "Trokky Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trokky/trokky.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}

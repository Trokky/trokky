{
  "name": "@trokky/adapter-postgres-data",
  "version": "0.1.8",
  "description": "PostgreSQL-based data storage adapter for Trokky CMS (documents, users, tokens)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "echo 'Tests require full monorepo setup' && exit 0",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "trokky",
    "cms",
    "storage",
    "postgres",
    "postgresql",
    "data",
    "adapter",
    "datalake"
  ],
  "author": "Trokky Team",
  "license": "MIT",
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "dependencies": {
    "@trokky/core": "*",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/pg": "^8.10.9",
    "@types/node": "^20.11.19",
    "@types/jest": "^29.5.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "@trokky/core": "*"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trokky/trokky.git"
  }

{
  "name": "@trokky/types",
  "version": "0.1.1",
  "description": "Shared TypeScript types for Trokky ecosystem",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./media": {
      "types": "./dist/media.d.ts",
      "import": "./dist/media.js"
    },
    "./fields": {
      "types": "./dist/fields.d.ts",
      "import": "./dist/fields.js"
    },
    "./slug": {
      "types": "./dist/slug.d.ts",
      "import": "./dist/slug.js"
    },
    "./field-system": {
      "types": "./dist/field-system.d.ts",
      "import": "./dist/field-system.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./api-requests": {
      "types": "./dist/api-requests.d.ts",
      "import": "./dist/api-requests.js"
    },
    "./oauth2": {
      "types": "./dist/oauth2.d.ts",
      "import": "./dist/oauth2.js"
    },
    "./mail": {
      "types": "./dist/mail.d.ts",
      "import": "./dist/mail.js"
    },
    "./i18n": {
      "types": "./dist/i18n.d.ts",
      "import": "./dist/i18n.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "test": "echo 'Type-only package - no runtime tests needed' && exit 0"
  },
  "keywords": [
    "trokky",
    "types",
    "typescript",
    "cms"
  ],
  "author": "Trokky Team",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trokky/trokky.git"
  },
  "homepage": "https://github.com/trokky/trokky#readme",
  "bugs": {
    "url": "https://github.com/trokky/trokky/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
{
  "name": "@trokky/fields-browser",
  "version": "0.1.0",
  "description": "Browser-safe field type definitions and validation for Trokky CMS",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --project tsconfig.build.json --watch",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "cms",
    "fields",
    "validation",
    "browser",
    "typescript"
  ],
  "author": "Trokky Team",
  "license": "MIT",
  "dependencies": {
    "typescript": "^5.8.3"
  }
}

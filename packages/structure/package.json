{
  "name": "@trokky/structure",
  "version": "0.1.0",
  "description": "Configuration-driven content organization and Studio navigation system for Trokky CMS",
  "keywords": ["cms", "structure", "navigation", "content-management", "typescript"],
  "author": "Trokky Team",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./builder": {
      "import": "./dist/builder/index.js",
      "require": "./dist/builder/index.js",
      "types": "./dist/builder/index.d.ts"
    },
    "./views": {
      "import": "./dist/views/index.js",
      "require": "./dist/views/index.js",
      "types": "./dist/views/index.d.ts"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@trokky/core": "0.1.0",
    "@trokky/client": "0.1.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": ">=4.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/trokky-v2.git",
    "directory": "packages/structure"
  }
}
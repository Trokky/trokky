{
  "name": "@trokky/client",
  "version": "0.1.13",
  "description": "TypeScript-native client SDK for Trokky CMS with type generation and shortcode support",
  "keywords": [
    "cms",
    "client",
    "sdk",
    "typescript",
    "type-generation",
    "shortcodes",
    "media",
    "portable-content"
  ],
  "author": "Trokky Team",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "trokky-client": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.js"
    },
    "./query": {
      "types": "./dist/query/index.d.ts",
      "import": "./dist/query/index.js",
      "require": "./dist/query/index.js"
    },
    "./generator": {
      "types": "./dist/generator/index.d.ts",
      "import": "./dist/generator/index.js",
      "require": "./dist/generator/index.js"
    },
    "./document-generator": {
      "types": "./dist/generator/document-generator.d.ts",
      "import": "./dist/generator/document-generator.js",
      "require": "./dist/generator/document-generator.js"
    },
    "./shortcodes": {
      "types": "./dist/shortcodes/index.d.ts",
      "import": "./dist/shortcodes/index.js",
      "require": "./dist/shortcodes/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --watch",
    "test": "echo 'No tests configured for this package' && exit 0",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@trokky/core": "^0.1.0",
    "@trokky/types": "^0.1.0",
    "@faker-js/faker": "^8.0.0",
    "commander": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": ">=4.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trokky/trokky.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}

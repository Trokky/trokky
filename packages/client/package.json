{
  "name": "@trokky/client",
  "version": "0.1.0",
  "description": "TypeScript-native client SDK for Trokky CMS with type generation",
  "keywords": ["cms", "client", "sdk", "typescript", "type-generation"],
  "author": "Trokky Team",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "trokky-client": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./generator": {
      "types": "./dist/generator/index.d.ts",
      "import": "./dist/generator/index.js",
      "require": "./dist/generator/index.js"
    },
    "./document-generator": {
      "types": "./dist/generator/document-generator.d.ts",
      "import": "./dist/generator/document-generator.js",
      "require": "./dist/generator/document-generator.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@trokky/core": "0.1.0",
    "@faker-js/faker": "^8.0.0",
    "commander": "^11.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": ">=4.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/trokky-v2.git",
    "directory": "packages/client"
  }
}
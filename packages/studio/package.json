{
  "name": "@trokky/studio",
  "version": "0.1.30",
  "description": "Trokky Studio v2 - Zero-config content management interface",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "dev:server": "tsc src/index.ts src/server/assets.ts src/utils/logger.ts --outDir dist --module esnext --target es2020 --skipLibCheck --moduleResolution node --allowSyntheticDefaultImports --esModuleInterop --declaration --watch",
    "build": "vite build && npm run build:server",
    "build:single": "vite build --config vite.single.config.ts",
    "build:server": "tsc src/index.ts src/server/assets.ts src/utils/logger.ts --outDir dist --module esnext --target es2020 --skipLibCheck --moduleResolution node --allowSyntheticDefaultImports --esModuleInterop --declaration",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext ts,tsx",
    "test": "echo 'No tests configured for this package' && exit 0"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.2.0",
    "@simplewebauthn/browser": "^13.2.2",
    "@tanstack/react-query": "^5.0.0",
    "@trokky/fields": "^0.1.0",
    "@trokky/i18n": "^0.1.3",
    "@trokky/types": "^0.1.3",
    "clsx": "^2.0.0",
    "date-fns": "^2.29.0",
    "express": "^4.18.0",
    "fuse.js": "^7.0.0",
    "is-glob": "^4.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.8.0",
    "util-deprecate": "^1.0.2",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.42.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "postcss": "^8.4.24",
    "rollup": "4.45.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-singlefile": "^0.13.5",
    "vitest": "^1.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./integrated": {
      "import": "./dist/integrated/index.js",
      "types": "./dist/integrated/index.d.ts"
    },
    "./standalone": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./dist/server/assets.js": {
      "import": "./dist/server/assets.js",
      "types": "./dist/server/assets.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "cms",
    "content-management",
    "headless-cms",
    "trokky",
    "studio"
  ],
  "author": "Trokky Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trokky/trokky.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}

{
  "name": "@trokky/studio",
  "version": "2.0.1",
  "description": "Trokky Studio v2 - Zero-config content management interface",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "dev:server": "tsc src/index.ts src/server/assets.ts src/utils/logger.ts --outDir dist --module esnext --target es2020 --skipLibCheck --moduleResolution node --allowSyntheticDefaultImports --esModuleInterop --declaration --watch",
    "build": "vite build && npm run build:server",
    "build:single": "vite build --config vite.single.config.ts",
    "build:server": "tsc src/index.ts src/server/assets.ts src/utils/logger.ts --outDir dist --module esnext --target es2020 --skipLibCheck --moduleResolution node --allowSyntheticDefaultImports --esModuleInterop --declaration",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext ts,tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.2.0",
    "@portabletext/editor": "^1.1.0",
    "@simplewebauthn/browser": "^13.2.2",
    "@tanstack/react-query": "^5.0.0",
    "@tiptap/extension-character-count": "^2.10.6",
    "@tiptap/extension-code-block-lowlight": "^2.10.6",
    "@tiptap/extension-gapcursor": "^2.10.6",
    "@tiptap/extension-image": "^2.10.6",
    "@tiptap/extension-link": "^2.10.6",
    "@tiptap/extension-placeholder": "^2.10.6",
    "@tiptap/extension-table": "^2.10.6",
    "@tiptap/extension-table-cell": "^2.10.6",
    "@tiptap/extension-table-header": "^2.10.6",
    "@tiptap/extension-table-row": "^2.10.6",
    "@tiptap/extension-underline": "^2.10.6",
    "@tiptap/pm": "^2.10.6",
    "@tiptap/react": "^2.10.6",
    "@tiptap/starter-kit": "^2.10.6",
    "@trokky/trokky": "^2.0.1",
    "clsx": "^2.0.0",
    "date-fns": "^2.29.0",
    "express": "^4.18.0",
    "is-glob": "^4.0.3",
    "lowlight": "^3.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.8.0",
    "util-deprecate": "^1.0.2",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.42.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "jsdom": "^29.0.1",
    "postcss": "^8.4.24",
    "rollup": "^4.63.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-singlefile": "^0.13.5",
    "vitest": "^4.1.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./standalone": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./dist/server/assets.js": {
      "import": "./dist/server/assets.js",
      "types": "./dist/server/assets.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "cms",
    "content-management",
    "headless-cms",
    "trokky",
    "studio"
  ],
  "author": "Trokky Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trokky/trokky.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}

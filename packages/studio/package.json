{
  "name": "@trokky/studio",
  "version": "2.0.0",
  "description": "Trokky Studio v2 - Zero-config content management interface",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "dev:server": "tsc src/index.ts src/server/assets.ts src/utils/logger.ts --outDir dist --module esnext --target es2020 --skipLibCheck --moduleResolution node --allowSyntheticDefaultImports --esModuleInterop --declaration --watch",
    "build": "tsc && vite build",
    "build:single": "vite build --config vite.single.config.ts",
    "build:server": "tsc src/index.ts src/server/assets.ts src/utils/logger.ts --outDir dist --module esnext --target es2020 --skipLibCheck --moduleResolution node --allowSyntheticDefaultImports --esModuleInterop --declaration",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext ts,tsx",
    "test": "vitest"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.0",
    "@heroicons/react": "^2.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@trokky/fields": "file:../fields",
    "clsx": "^2.0.0",
    "date-fns": "^2.29.0",
    "express": "^4.18.0",
    "fuse.js": "^7.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0",
    "util-deprecate": "^1.0.2",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.42.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-singlefile": "^0.13.5",
    "vitest": "^1.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./integrated": {
      "import": "./dist/integrated/index.js",
      "types": "./dist/integrated/index.d.ts"
    },
    "./standalone": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "cms",
    "content-management",
    "headless-cms",
    "trokky",
    "studio"
  ],
  "author": "Trokky Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/trokky/trokky-v2.git",
    "directory": "packages/studio"
  }
}

{
  "name": "@trokky/core",
  "version": "2.0.5",
  "description": "Core CMS engine for Trokky v2",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "test": "echo 'No tests configured for this package' && exit 0",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "cms",
    "typescript",
    "content-management"
  ],
  "author": "Trokky Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trokky/trokky.git"
  },
  "homepage": "https://github.com/trokky/trokky#readme",
  "bugs": {
    "url": "https://github.com/trokky/trokky/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "dependencies": {
    "@trokky/types": "^0.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/sharp": "^0.31.1",
    "bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "qrcode": "^1.5.4",
    "zod": "^3.22.4"
  },
  "optionalDependencies": {
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.24",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.3.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  }
}

{
  "name": "@trokky/fields",
  "version": "0.1.3",
  "description": "Universal field system for Trokky CMS - works in browser, Node.js, and edge environments",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --skipLibCheck",
    "build:watch": "tsc --project tsconfig.build.json --watch",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "echo 'No tests configured for this package' && exit 0",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@portabletext/editor": "^1.1.0",
    "@heroicons/react": "^2.0.18",
    "@tiptap/react": "^2.10.6",
    "@tiptap/pm": "^2.10.6",
    "@tiptap/starter-kit": "^2.10.6",
    "@tiptap/extension-link": "^2.10.6",
    "@tiptap/extension-underline": "^2.10.6",
    "@tiptap/extension-placeholder": "^2.10.6",
    "@tiptap/extension-character-count": "^2.10.6",
    "@tiptap/extension-image": "^2.10.6",
    "@tiptap/extension-table": "^2.10.6",
    "@tiptap/extension-table-row": "^2.10.6",
    "@tiptap/extension-table-header": "^2.10.6",
    "@tiptap/extension-table-cell": "^2.10.6",
    "@tiptap/extension-gapcursor": "^2.10.6",
    "@tiptap/extension-code-block-lowlight": "^2.10.6",
    "@trokky/types": "0.1.0",
    "lowlight": "^3.1.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "trokky",
    "cms",
    "fields",
    "react",
    "universal",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trokky/trokky.git"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}

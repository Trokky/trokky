{
  "name": "@trokky/mail-adapter-smtp",
  "version": "0.1.0",
  "description": "SMTP mail adapter for Trokky CMS using Nodemailer",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@trokky/mail": "^0.1.0",
    "@trokky/core": "^0.1.0",
    "nodemailer": "^6.9.9"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.19",
    "@types/nodemailer": "^6.4.14",
    "jest": "^29.7.0",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "trokky",
    "mail",
    "email",
    "smtp",
    "nodemailer"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/trokky/trokky.git",
    "directory": "packages/mail-adapters/smtp"
  },
  "license": "MIT"
}

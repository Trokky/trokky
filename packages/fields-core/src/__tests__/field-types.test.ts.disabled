import {
  StringFieldType,
  NumberFieldType,
  BooleanFieldType,
  DateFieldType,
  ArrayFieldType,
  ObjectFieldType,
  ReferenceFieldType,
  SimpleStringFieldType,
  BuiltInFieldTypes,
  registerBuiltInFieldTypes
} from '../index'
import { FieldTypeRegistry } from '@trokky/core'

// Mock field context for testing
const mockContext = {
  document: {},
  fieldPath: ['testField'],
  user: { id: 'user1', email: 'test@example.com', firstName: 'Test', lastName: 'User', passwordHash: 'hash', permissions: [], role: 'user' as const },
  permissions: [],
  userRole: 'user' as const,
  httpClient: {} as any,
  apiClient: {} as any,
  getValue: jest.fn(),
  setValue: jest.fn(),
  getFieldConfig: jest.fn(),
  errors: [],
  touched: {},
  isStudio: false,
  isPreview: false,
  emit: jest.fn(),
  on: jest.fn()
}

describe('Built-in Field Types', () => {
  
  describe('Field Type Registration', () => {
    beforeEach(() => {
      // Clear registry before each test
      FieldTypeRegistry['types'].clear()
      FieldTypeRegistry['categories'].clear()
      FieldTypeRegistry['metadata'].clear()
    })

    it('should export all built-in field types', () => {
      expect(BuiltInFieldTypes).toHaveLength(8)
      expect(BuiltInFieldTypes).toContain(SimpleStringFieldType)
      expect(BuiltInFieldTypes).toContain(StringFieldType)
      expect(BuiltInFieldTypes).toContain(NumberFieldType)
      expect(BuiltInFieldTypes).toContain(BooleanFieldType)
      expect(BuiltInFieldTypes).toContain(DateFieldType)
      expect(BuiltInFieldTypes).toContain(ArrayFieldType)
      expect(BuiltInFieldTypes).toContain(ObjectFieldType)
      expect(BuiltInFieldTypes).toContain(ReferenceFieldType)
    })

    it('should register all field types successfully', () => {
      registerBuiltInFieldTypes()
      
      expect(FieldTypeRegistry.get('simple-string')).toBe(SimpleStringFieldType)
      expect(FieldTypeRegistry.get('string')).toBe(StringFieldType)
      expect(FieldTypeRegistry.get('number')).toBe(NumberFieldType)
      expect(FieldTypeRegistry.get('boolean')).toBe(BooleanFieldType)
      expect(FieldTypeRegistry.get('date')).toBe(DateFieldType)
      expect(FieldTypeRegistry.get('array')).toBe(ArrayFieldType)
      expect(FieldTypeRegistry.get('object')).toBe(ObjectFieldType)
      expect(FieldTypeRegistry.get('reference')).toBe(ReferenceFieldType)
    })
  })

  describe('SimpleStringFieldType', () => {
    it('should validate string values correctly', () => {
      const result = SimpleStringFieldType.validate('test', {}, mockContext)
      expect(result.valid).toBe(true)
      expect(result.errors).toHaveLength(0)
    })

    it('should reject non-string values', () => {
      const result = SimpleStringFieldType.validate(123 as any, {}, mockContext)
      expect(result.valid).toBe(false)
      expect(result.errors).toHaveLength(1)
      expect(result.errors[0].code).toBe('INVALID_TYPE')
    })

    it('should enforce max length', () => {
      const result = SimpleStringFieldType.validate('toolong', { maxLength: 5 }, mockContext)
      expect(result.valid).toBe(false)
      expect(result.errors).toHaveLength(1)
      expect(result.errors[0].code).toBe('MAX_LENGTH')
    })

    it('should serialize and deserialize correctly', () => {
      const serialized = SimpleStringFieldType.serialize('test', {})
      expect(serialized).toBe('test')
      
      const deserialized = SimpleStringFieldType.deserialize('test', {})
      expect(deserialized).toBe('test')
    })
  })

  describe('StringFieldType', () => {
    it('should validate email format', () => {
      const validEmail = StringFieldType.validate('test@example.com', { format: 'email' }, mockContext)
      expect(validEmail.valid).toBe(true)

      const invalidEmail = StringFieldType.validate('invalid-email', { format: 'email' }, mockContext)
      expect(invalidEmail.valid).toBe(false)
      expect(invalidEmail.errors[0].code).toBe('INVALID_EMAIL')
    })

    it('should validate URL format', () => {
      const validUrl = StringFieldType.validate('https://example.com', { format: 'url' }, mockContext)
      expect(validUrl.valid).toBe(true)

      const invalidUrl = StringFieldType.validate('not-a-url', { format: 'url' }, mockContext)
      expect(invalidUrl.valid).toBe(false)
      expect(invalidUrl.errors[0].code).toBe('INVALID_URL')
    })

    it('should enforce length constraints', () => {
      const tooShort = StringFieldType.validate('hi', { minLength: 5 }, mockContext)
      expect(tooShort.valid).toBe(false)
      expect(tooShort.errors[0].code).toBe('MIN_LENGTH')

      const tooLong = StringFieldType.validate('this is way too long', { maxLength: 10 }, mockContext)
      expect(tooLong.valid).toBe(false)
      expect(tooLong.errors[0].code).toBe('MAX_LENGTH')
    })
  })

  describe('NumberFieldType', () => {
    it('should validate number values correctly', () => {
      const result = NumberFieldType.validate(42, {}, mockContext)
      expect(result.valid).toBe(true)
      expect(result.errors).toHaveLength(0)
    })

    it('should reject non-number values', () => {
      const result = NumberFieldType.validate('not-a-number' as any, {}, mockContext)
      expect(result.valid).toBe(false)
      expect(result.errors[0].code).toBe('INVALID_TYPE')
    })

    it('should enforce min/max constraints', () => {
      const tooSmall = NumberFieldType.validate(5, { min: 10 }, mockContext)
      expect(tooSmall.valid).toBe(false)
      expect(tooSmall.errors[0].code).toBe('MIN_VALUE')

      const tooBig = NumberFieldType.validate(15, { max: 10 }, mockContext)
      expect(tooBig.valid).toBe(false)
      expect(tooBig.errors[0].code).toBe('MAX_VALUE')
    })

    it('should validate integer format', () => {
      const validInteger = NumberFieldType.validate(42, { format: 'integer' }, mockContext)
      expect(validInteger.valid).toBe(true)

      const invalidInteger = NumberFieldType.validate(42.5, { format: 'integer' }, mockContext)
      expect(invalidInteger.valid).toBe(false)
      expect(invalidInteger.errors[0].code).toBe('MUST_BE_INTEGER')
    })
  })

  describe('BooleanFieldType', () => {
    it('should validate boolean values correctly', () => {
      const trueResult = BooleanFieldType.validate(true, {}, mockContext)
      expect(trueResult.valid).toBe(true)

      const falseResult = BooleanFieldType.validate(false, {}, mockContext)
      expect(falseResult.valid).toBe(true)
    })

    it('should reject non-boolean values', () => {
      const result = BooleanFieldType.validate('true' as any, {}, mockContext)
      expect(result.valid).toBe(false)
      expect(result.errors[0].code).toBe('INVALID_TYPE')
    })

    it('should deserialize various formats', () => {
      expect(BooleanFieldType.deserialize(true, {})).toBe(true)
      expect(BooleanFieldType.deserialize('true', {})).toBe(true)
      expect(BooleanFieldType.deserialize('yes', {})).toBe(true)
      expect(BooleanFieldType.deserialize('1', {})).toBe(true)
      expect(BooleanFieldType.deserialize(1, {})).toBe(true)
      
      expect(BooleanFieldType.deserialize(false, {})).toBe(false)
      expect(BooleanFieldType.deserialize('false', {})).toBe(false)
      expect(BooleanFieldType.deserialize('no', {})).toBe(false)
      expect(BooleanFieldType.deserialize('0', {})).toBe(false)
      expect(BooleanFieldType.deserialize(0, {})).toBe(false)
    })
  })

  describe('DateFieldType', () => {
    it('should validate valid date strings', () => {
      const result = DateFieldType.validate('2024-01-15T00:00:00.000Z', {}, mockContext)
      expect(result.valid).toBe(true)
      expect(result.errors).toHaveLength(0)
    })

    it('should reject invalid date strings', () => {
      const result = DateFieldType.validate('invalid-date', {}, mockContext)
      expect(result.valid).toBe(false)
      expect(result.errors[0].code).toBe('INVALID_DATE')
    })

    it('should enforce date range constraints', () => {
      const earlyDate = DateFieldType.validate('2020-01-01T00:00:00.000Z', { 
        min: '2024-01-01T00:00:00.000Z' 
      }, mockContext)
      expect(earlyDate.valid).toBe(false)
      expect(earlyDate.errors[0].code).toBe('MIN_DATE')

      const lateDate = DateFieldType.validate('2025-01-01T00:00:00.000Z', { 
        max: '2024-12-31T00:00:00.000Z' 
      }, mockContext)
      expect(lateDate.valid).toBe(false)
      expect(lateDate.errors[0].code).toBe('MAX_DATE')
    })
  })

  describe('ArrayFieldType', () => {
    it('should validate array values correctly', () => {
      const result = ArrayFieldType.validate(['a', 'b', 'c'], {
        of: [{ type: 'string', name: 'item' }]
      }, mockContext)
      expect(result.valid).toBe(true)
      expect(result.errors).toHaveLength(0)
    })

    it('should reject non-array values', () => {
      const result = ArrayFieldType.validate('not-an-array' as any, {
        of: [{ type: 'string', name: 'item' }]
      }, mockContext)
      expect(result.valid).toBe(false)
      expect(result.errors[0].code).toBe('INVALID_TYPE')
    })

    it('should enforce length constraints', () => {
      const tooShort = ArrayFieldType.validate(['a'], { 
        of: [{ type: 'string', name: 'item' }],
        min: 3 
      }, mockContext)
      expect(tooShort.valid).toBe(false)
      expect(tooShort.errors[0].code).toBe('MIN_ITEMS')

      const tooLong = ArrayFieldType.validate(['a', 'b', 'c'], { 
        of: [{ type: 'string', name: 'item' }],
        max: 2 
      }, mockContext)
      expect(tooLong.valid).toBe(false)
      expect(tooLong.errors[0].code).toBe('MAX_ITEMS')
    })

    it('should enforce uniqueness when required', () => {
      const result = ArrayFieldType.validate(['a', 'b', 'a'], {
        of: [{ type: 'string', name: 'item' }],
        unique: true
      }, mockContext)
      expect(result.valid).toBe(false)
      expect(result.errors[0].code).toBe('DUPLICATE_ITEM')
    })
  })

  describe('ObjectFieldType', () => {
    it('should validate object values correctly', () => {
      const result = ObjectFieldType.validate({ name: 'John', age: 30 }, {
        fields: {
          name: { type: 'string', name: 'name' },
          age: { type: 'number', name: 'age' }
        }
      }, mockContext)
      expect(result.valid).toBe(true)
      expect(result.errors).toHaveLength(0)
    })

    it('should reject non-object values', () => {
      const result = ObjectFieldType.validate('not-an-object' as any, {
        fields: {}
      }, mockContext)
      expect(result.valid).toBe(false)
      expect(result.errors[0].code).toBe('INVALID_TYPE')
    })

    it('should validate required fields', () => {
      const result = ObjectFieldType.validate({}, {
        fields: {
          name: { type: 'string', name: 'name', required: true }
        }
      }, mockContext)
      expect(result.valid).toBe(false)
      expect(result.errors[0].code).toBe('REQUIRED')
    })
  })

  describe('ReferenceFieldType', () => {
    const validReference = { _type: 'reference' as const, _ref: 'doc123' }

    it('should validate reference values correctly', () => {
      const result = ReferenceFieldType.validate(validReference, {
        to: ['document']
      }, mockContext)
      expect(result.valid).toBe(true)
      expect(result.errors).toHaveLength(0)
    })

    it('should reject invalid reference structure', () => {
      const result = ReferenceFieldType.validate('not-a-reference' as any, {
        to: ['document']
      }, mockContext)
      expect(result.valid).toBe(false)
      expect(result.errors[0].code).toBe('INVALID_REFERENCE')
    })

    it('should require valid reference ID', () => {
      const result = ReferenceFieldType.validate({ _type: 'reference' as const, _ref: '' }, {
        to: ['document']
      }, mockContext)
      expect(result.valid).toBe(false)
      expect(result.errors[0].code).toBe('INVALID_REF_ID')
    })

    it('should serialize references correctly', () => {
      const serialized = ReferenceFieldType.serialize(validReference, { to: ['document'] })
      expect(serialized).toEqual(validReference)
    })
  })
})
{
  "name": "@trokky/routes",
  "version": "0.1.0",
  "description": "Framework-agnostic HTTP route handlers for Trokky v2",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "cms",
    "routes",
    "http",
    "framework-agnostic",
    "rest-api"
  ],
  "author": "Trokky Team",
  "license": "MIT",
  "dependencies": {
    "@trokky/core": "file:../core"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  }
}
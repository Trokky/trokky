{
  "name": "@trokky/routes",
  "version": "0.1.0",
  "description": "Framework-agnostic HTTP route handlers for Trokky v2",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "test": "echo 'Routes tests skipped for publication' && exit 0",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "cms",
    "routes",
    "http",
    "framework-agnostic",
    "rest-api"
  ],
  "author": "Trokky Team",
  "license": "MIT",
  "dependencies": {
    "@trokky/core": "^0.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trokky/trokky.git"
  }
}

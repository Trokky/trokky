{
  "name": "@trokky/trokky",
  "version": "2.0.2",
  "description": "Modern, composable Content Management System - Server package",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./types/media": {
      "types": "./dist/types/media.d.ts",
      "import": "./dist/types/media.js"
    },
    "./types/fields": {
      "types": "./dist/types/fields.d.ts",
      "import": "./dist/types/fields.js"
    },
    "./types/slug": {
      "types": "./dist/types/slug.d.ts",
      "import": "./dist/types/slug.js"
    },
    "./types/field-system": {
      "types": "./dist/types/field-system.d.ts",
      "import": "./dist/types/field-system.js"
    },
    "./types/auth": {
      "types": "./dist/types/auth.d.ts",
      "import": "./dist/types/auth.js"
    },
    "./types/http": {
      "types": "./dist/types/http.d.ts",
      "import": "./dist/types/http.js"
    },
    "./types/api-requests": {
      "types": "./dist/types/api-requests.d.ts",
      "import": "./dist/types/api-requests.js"
    },
    "./types/oauth2": {
      "types": "./dist/types/oauth2.d.ts",
      "import": "./dist/types/oauth2.js"
    },
    "./types/mail": {
      "types": "./dist/types/mail.d.ts",
      "import": "./dist/types/mail.js"
    },
    "./types/i18n": {
      "types": "./dist/types/i18n.d.ts",
      "import": "./dist/types/i18n.js"
    },
    "./structure": {
      "types": "./dist/structure/index.d.ts",
      "import": "./dist/structure/index.js"
    },
    "./mail": {
      "types": "./dist/mail/index.d.ts",
      "import": "./dist/mail/index.js"
    },
    "./mail/console": {
      "types": "./dist/mail/adapters/console.d.ts",
      "import": "./dist/mail/adapters/console.js"
    },
    "./mail/resend": {
      "types": "./dist/mail/adapters/resend.d.ts",
      "import": "./dist/mail/adapters/resend.js"
    },
    "./mail/smtp": {
      "types": "./dist/mail/adapters/smtp.d.ts",
      "import": "./dist/mail/adapters/smtp.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js"
    },
    "./adapters/filesystem-data": {
      "types": "./dist/adapters/filesystem-data/index.d.ts",
      "import": "./dist/adapters/filesystem-data/index.js"
    },
    "./adapters/filesystem-media": {
      "types": "./dist/adapters/filesystem-media/index.d.ts",
      "import": "./dist/adapters/filesystem-media/index.js"
    },
    "./adapters/postgres-data": {
      "types": "./dist/adapters/postgres-data/index.d.ts",
      "import": "./dist/adapters/postgres-data/index.js"
    },
    "./express": {
      "types": "./dist/integrations/express/index.d.ts",
      "import": "./dist/integrations/express/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --project tsconfig.build.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "cms",
    "typescript",
    "content-management",
    "trokky"
  ],
  "author": "Trokky Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trokky/trokky.git"
  },
  "homepage": "https://trokky.dev",
  "bugs": {
    "url": "https://github.com/trokky/trokky/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "peerDependencies": {
    "@trokky/studio": "^2.0.2",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@trokky/studio": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.2.2",
    "bcrypt": "^6.0.0",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "fs-extra": "^11.3.2",
    "i18next": "^24.2.2",
    "i18next-browser-languagedetector": "^8.0.4",
    "jsonwebtoken": "^9.0.2",
    "qrcode": "^1.5.4",
    "react-i18next": "^15.4.1",
    "zod": "^3.22.4"
  },
  "optionalDependencies": {
    "nodemailer": "^10.0.1",
    "pg": "^8.11.3",
    "resend": "^3.5.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/busboy": "^1.5.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.24",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "@types/sharp": "^0.31.1",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.0",
    "supertest": "^7.2.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.0"
  }
}

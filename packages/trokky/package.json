{
  "name": "@trokky/trokky",
  "version": "0.1.0",
  "description": "TypeScript-native client SDK and CLI for Trokky CMS with backup/restore and migration tools",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "trokky": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "test": "echo 'No tests configured for this package' && exit 0",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cms",
    "client",
    "sdk",
    "cli",
    "backup",
    "restore",
    "migration",
    "typescript",
    "trokky",
    "content-management"
  ],
  "author": "Trokky Team",
  "license": "MIT",
  "dependencies": {
    "@trokky/core": "^0.1.0",
    "@trokky/types": "^0.1.0",
    "commander": "^11.1.0",
    "chalk": "^5.3.0",
    "ora": "^7.0.1",
    "archiver": "^6.0.1",
    "fs-extra": "^11.1.1",
    "unzipper": "^0.10.11"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.3",
    "@types/archiver": "^6.0.0",
    "@types/fs-extra": "^11.0.1",
    "@types/unzipper": "^0.10.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trokky/trokky.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

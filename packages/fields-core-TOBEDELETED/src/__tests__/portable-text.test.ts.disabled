/**
 * Portable Text Field Type Tests
 */

import {
  PortableTextFieldType,
  createTextBlock,
  createImageBlock,
  createCodeBlock,
  createSpan,
  createLinkMarkDef,
  validatePortableText,
  toHTML,
  toMarkdown,
  toPlainText,
  normalizePortableText,
  getWordCount,
  getCharacterCount,
  extractImages,
  extractLinks,
  DEFAULT_PORTABLE_TEXT_CONFIG
} from '../types/portable-text'
import type { PortableTextValue, PortableTextFieldConfig } from '../types/portable-text'

// Mock field context for testing
const mockContext = {
  document: {},
  fieldPath: ['content'],
  user: { 
    id: 'user1', 
    email: 'test@example.com', 
    firstName: 'Test', 
    lastName: 'User', 
    passwordHash: 'hash', 
    permissions: [], 
    role: 'user' as const 
  },
  permissions: [],
  userRole: 'user' as const,
  httpClient: {} as any,
  apiClient: {} as any,
  getValue: jest.fn(),
  setValue: jest.fn(),
  getFieldConfig: jest.fn(),
  errors: [],
  touched: {},
  isStudio: false,
  isPreview: false,
  emit: jest.fn(),
  on: jest.fn()
}

describe('Portable Text Field Type', () => {

  describe('Field Type Basic Properties', () => {
    it('should have correct basic properties', () => {
      expect(PortableTextFieldType.name).toBe('portableText')
      expect(PortableTextFieldType.category).toBe('text')
      expect(PortableTextFieldType.description).toContain('Rich text editor')
      expect(PortableTextFieldType.defaultValue).toEqual([])
    })
  })

  describe('Validation', () => {
    it('should validate empty content as valid by default', () => {
      const result = PortableTextFieldType.validate([], DEFAULT_PORTABLE_TEXT_CONFIG, mockContext)
      expect(result.valid).toBe(true)
      expect(result.errors).toHaveLength(0)
    })

    it('should validate null content as valid by default', () => {
      const result = PortableTextFieldType.validate(null as any, DEFAULT_PORTABLE_TEXT_CONFIG, mockContext)
      expect(result.valid).toBe(true)
      expect(result.errors).toHaveLength(0)
    })

    it('should validate null content as invalid when minBlocks is set', () => {
      const config = { ...DEFAULT_PORTABLE_TEXT_CONFIG, minBlocks: 1 }
      const result = PortableTextFieldType.validate(null as any, config, mockContext)
      expect(result.valid).toBe(false)
      expect(result.errors).toHaveLength(1)
      expect(result.errors[0].code).toBe('REQUIRED')
    })

    it('should validate simple text block', () => {
      const value: PortableTextValue = [createTextBlock('Hello world')]
      const result = PortableTextFieldType.validate(value, DEFAULT_PORTABLE_TEXT_CONFIG, mockContext)
      expect(result.valid).toBe(true)
      expect(result.errors).toHaveLength(0)
    })

    it('should validate content with links', () => {
      const linkMarkDef = createLinkMarkDef('https://example.com', 'Example')
      const span = createSpan('Visit our website', [linkMarkDef._key])
      const value: PortableTextValue = [{
        _type: 'block',
        _key: 'block1',
        style: 'normal',
        children: [span],
        markDefs: [linkMarkDef]
      }]
      
      const result = PortableTextFieldType.validate(value, DEFAULT_PORTABLE_TEXT_CONFIG, mockContext)
      expect(result.valid).toBe(true)
      expect(result.errors).toHaveLength(0)
    })

    it('should catch invalid block types', () => {
      const config = { ...DEFAULT_PORTABLE_TEXT_CONFIG, allowedBlockTypes: ['block'] }
      const value: PortableTextValue = [createImageBlock('image123', 'Alt text')]
      
      const result = PortableTextFieldType.validate(value, config, mockContext)
      expect(result.valid).toBe(false)
      expect(result.errors).toHaveLength(1)
      expect(result.errors[0].code).toBe('INVALID_BLOCK_TYPE')
    })

    it('should catch invalid marks', () => {
      const config = { ...DEFAULT_PORTABLE_TEXT_CONFIG, allowedMarks: ['strong'] }
      const span = createSpan('Italic text', ['em'])
      const value: PortableTextValue = [{
        _type: 'block',
        _key: 'block1',
        style: 'normal',
        children: [span],
        markDefs: []
      }]
      
      const result = PortableTextFieldType.validate(value, config, mockContext)
      expect(result.valid).toBe(false)
      expect(result.errors).toHaveLength(1)
      expect(result.errors[0].code).toBe('INVALID_MARK')
    })
  })

  describe('Serialization', () => {
    it('should serialize portable text value', () => {
      const value: PortableTextValue = [createTextBlock('Test content')]
      const result = PortableTextFieldType.serialize(value, DEFAULT_PORTABLE_TEXT_CONFIG)
      
      expect(Array.isArray(result)).toBe(true)
      expect(result).toHaveLength(1)
      expect(result[0]._type).toBe('block')
    })

    it('should handle null value in serialization', () => {
      const result = PortableTextFieldType.serialize(null as any, DEFAULT_PORTABLE_TEXT_CONFIG)
      expect(result).toEqual([])
    })

    it('should normalize portable text during serialization', () => {
      const value: PortableTextValue = [
        createTextBlock(''), // Empty block should be removed
        createTextBlock('Valid content')
      ]
      
      const result = PortableTextFieldType.serialize(value, DEFAULT_PORTABLE_TEXT_CONFIG)
      expect(result).toHaveLength(1)
      expect(result[0].children[0].text).toBe('Valid content')
    })
  })

  describe('Deserialization', () => {
    it('should deserialize null to empty array', () => {
      const result = PortableTextFieldType.deserialize(null, DEFAULT_PORTABLE_TEXT_CONFIG)
      expect(result).toEqual([])
    })

    it('should deserialize string to text block', () => {
      const result = PortableTextFieldType.deserialize('Hello world', DEFAULT_PORTABLE_TEXT_CONFIG)
      
      expect(result).toHaveLength(1)
      expect(result[0]._type).toBe('block')
      expect(result[0].children[0].text).toBe('Hello world')
    })

    it('should deserialize portable text array', () => {
      const value: PortableTextValue = [createTextBlock('Test')]
      const result = PortableTextFieldType.deserialize(value, DEFAULT_PORTABLE_TEXT_CONFIG)
      
      expect(result).toHaveLength(1)
      expect(result[0]._type).toBe('block')
    })

    it('should handle unknown format', () => {
      const result = PortableTextFieldType.deserialize({ unknown: 'format' }, DEFAULT_PORTABLE_TEXT_CONFIG)
      expect(result).toEqual([])
    })
  })

})

describe('Portable Text Utilities', () => {

  describe('Block Creation', () => {
    it('should create text block', () => {
      const block = createTextBlock('Hello world', 'h1', ['strong'])
      
      expect(block._type).toBe('block')
      expect(block.style).toBe('h1')
      expect(block.children).toHaveLength(1)
      expect(block.children[0].text).toBe('Hello world')
      expect(block.children[0].marks).toEqual(['strong'])
    })

    it('should create image block', () => {
      const block = createImageBlock('image123', 'Alt text', 'Caption')
      
      expect(block._type).toBe('image')
      expect(block.asset._ref).toBe('image123')
      expect(block.alt).toBe('Alt text')
      expect(block.caption).toBe('Caption')
    })

    it('should create code block', () => {
      const block = createCodeBlock('console.log("hello")', 'javascript', 'app.js')
      
      expect(block._type).toBe('code')
      expect(block.code).toBe('console.log("hello")')
      expect(block.language).toBe('javascript')
      expect(block.filename).toBe('app.js')
    })
  })

  describe('Content Analysis', () => {
    const sampleContent: PortableTextValue = [
      createTextBlock('Hello world'),
      createTextBlock('This is a longer paragraph with more words.'),
      createImageBlock('image123', 'Test image'),
      createCodeBlock('const x = 1', 'javascript')
    ]

    it('should count words correctly', () => {
      const count = getWordCount(sampleContent)
      expect(count).toBe(11) // "Hello world This is a longer paragraph with more words"
    })

    it('should count characters correctly', () => {
      const count = getCharacterCount(sampleContent, false) // without spaces
      expect(count).toBe(44) // Total character count without spaces
    })

    it('should extract images', () => {
      const images = extractImages(sampleContent)
      expect(images).toHaveLength(1)
      expect(images[0]._type).toBe('image')
      expect(images[0].asset._ref).toBe('image123')
    })

    it('should extract links', () => {
      const linkMarkDef = createLinkMarkDef('https://example.com')
      const span = createSpan('Link text', [linkMarkDef._key])
      const blockWithLink: PortableTextValue = [{
        _type: 'block',
        _key: 'block1',
        style: 'normal',
        children: [span],
        markDefs: [linkMarkDef]
      }]
      
      const links = extractLinks(blockWithLink)
      expect(links).toHaveLength(1)
      expect(links[0]._type).toBe('link')
      expect(links[0].href).toBe('https://example.com')
    })
  })

  describe('Content Normalization', () => {
    it('should remove empty blocks', () => {
      const value: PortableTextValue = [
        createTextBlock(''), // Empty block
        createTextBlock('Valid content'),
        createTextBlock('   '), // Whitespace only
        createTextBlock('Another valid block')
      ]
      
      const normalized = normalizePortableText(value)
      expect(normalized).toHaveLength(2)
      expect(normalized[0].children[0].text).toBe('Valid content')
      expect(normalized[1].children[0].text).toBe('Another valid block')
    })

    it('should remove orphaned mark definitions', () => {
      const orphanedMarkDef = createLinkMarkDef('https://orphaned.com')
      const usedMarkDef = createLinkMarkDef('https://used.com')
      const span = createSpan('Text with link', [usedMarkDef._key])
      
      const value: PortableTextValue = [{
        _type: 'block',
        _key: 'block1',
        style: 'normal',
        children: [span],
        markDefs: [orphanedMarkDef, usedMarkDef] // orphanedMarkDef is not used in any span
      }]
      
      const normalized = normalizePortableText(value)
      expect(normalized[0].markDefs).toHaveLength(1)
      expect(normalized[0].markDefs![0]._key).toBe(usedMarkDef._key)
    })
  })

})

describe('Portable Text Serialization', () => {

  const sampleContent: PortableTextValue = [
    createTextBlock('Hello world', 'h1'),
    createTextBlock('This is a paragraph with some bold text.', 'normal'),
    createImageBlock('image123', 'Test image', 'This is a caption'),
    createCodeBlock('console.log("hello")', 'javascript', 'app.js')
  ]

  describe('HTML Serialization', () => {
    it('should convert to HTML', () => {
      const html = toHTML(sampleContent)
      
      expect(html).toContain('<h1>Hello world</h1>')
      expect(html).toContain('<p>This is a paragraph with some bold text.</p>')
      expect(html).toContain('<img src="/assets/image123" alt="Test image"')
      expect(html).toContain('<figcaption>This is a caption</figcaption>')
      expect(html).toContain('<code class="language-javascript">console.log("hello")</code>')
      expect(html).toContain('<div class="code-filename">app.js</div>')
    })

    it('should handle text with marks', () => {
      const span = createSpan('Bold text', ['strong'])
      const block: PortableTextValue = [{
        _type: 'block',
        _key: 'block1',
        style: 'normal',
        children: [span],
        markDefs: []
      }]
      
      const html = toHTML(block)
      expect(html).toContain('<strong>Bold text</strong>')
    })

    it('should handle links', () => {
      const linkMarkDef = createLinkMarkDef('https://example.com', 'Example Site')
      const span = createSpan('Visit our site', [linkMarkDef._key])
      const block: PortableTextValue = [{
        _type: 'block',
        _key: 'block1',
        style: 'normal',
        children: [span],
        markDefs: [linkMarkDef]
      }]
      
      const html = toHTML(block)
      expect(html).toContain('<a href="https://example.com" title="Example Site">Visit our site</a>')
    })
  })

  describe('Markdown Serialization', () => {
    it('should convert to Markdown', () => {
      const markdown = toMarkdown(sampleContent)
      
      expect(markdown).toContain('# Hello world')
      expect(markdown).toContain('This is a paragraph with some bold text.')
      expect(markdown).toContain('![Test image](/assets/image123)')
      expect(markdown).toContain('*This is a caption*')
      expect(markdown).toContain('```javascript')
      expect(markdown).toContain('// app.js')
      expect(markdown).toContain('console.log("hello")')
    })

    it('should handle text with marks', () => {
      const span = createSpan('Bold text', ['strong'])
      const block: PortableTextValue = [{
        _type: 'block',
        _key: 'block1',
        style: 'normal',
        children: [span],
        markDefs: []
      }]
      
      const markdown = toMarkdown(block)
      expect(markdown).toContain('**Bold text**')
    })

    it('should handle links in markdown', () => {
      const linkMarkDef = createLinkMarkDef('https://example.com', 'Example Site')
      const span = createSpan('Visit our site', [linkMarkDef._key])
      const block: PortableTextValue = [{
        _type: 'block',
        _key: 'block1',
        style: 'normal',
        children: [span],
        markDefs: [linkMarkDef]
      }]
      
      const markdown = toMarkdown(block)
      expect(markdown).toContain('[Visit our site](https://example.com "Example Site")')
    })
  })

  describe('Plain Text Serialization', () => {
    it('should convert to plain text', () => {
      const plainText = toPlainText(sampleContent)
      
      expect(plainText).toContain('Hello world')
      expect(plainText).toContain('This is a paragraph with some bold text.')
      expect(plainText).toContain('console.log("hello")')
      expect(plainText).not.toContain('<')
      expect(plainText).not.toContain('>')
    })
  })

})
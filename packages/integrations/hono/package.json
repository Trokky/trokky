{
  "name": "@trokky/hono",
  "version": "0.1.0",
  "description": "Hono integration for Trokky CMS - Cloudflare Workers compatible",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@trokky/core": "file:../../core",
    "@trokky/routes": "file:../../routes",
    "hono": "^4.0.0"
  },
  "optionalDependencies": {
    "@trokky/adapter-filesystem-data": "file:../../adapters/filesystem-data",
    "@trokky/adapter-filesystem-media": "file:../../adapters/filesystem-media",
    "@trokky/adapter-cloudflare-d1": "file:../../adapters/cloudflare-d1",
    "@trokky/adapter-cloudflare-r2": "file:../../adapters/cloudflare-r2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240821.1",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "hono": "^4.0.0"
  },
  "keywords": [
    "trokky",
    "cms",
    "hono",
    "cloudflare",
    "workers",
    "edge"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trokky/trokky.git"
  }
}

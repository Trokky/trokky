{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "composite": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2020"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.test.ts",
    "**/__tests__/**/*"
  ],
  "references": [
    { "path": "../../core" },
    { "path": "../../routes" },
    { "path": "../../adapters/filesystem" }
  ]
}
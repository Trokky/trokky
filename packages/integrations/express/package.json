{
  "name": "@trokky/express",
  "version": "0.1.0",
  "description": "Express.js integration for Trokky v2 CMS",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "test": "echo 'No tests configured for this package' && exit 0",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "cms",
    "express",
    "middleware",
    "http",
    "rest-api"
  ],
  "author": "Trokky Team",
  "license": "MIT",
  "dependencies": {
    "@trokky/adapter-filesystem-data": "^0.1.0",
    "@trokky/adapter-filesystem-media": "^0.1.0",
    "@trokky/core": "^0.1.0",
    "@trokky/routes": "^0.1.0",
    "@types/busboy": "^1.5.4",
    "busboy": "^1.6.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "fs-extra": "^11.2.0",
    "typescript": "^5.3.3"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trokky/trokky.git"
  }
}

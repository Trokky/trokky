{
  "name": "@trokky/express",
  "version": "0.1.0",
  "description": "Express.js integration for Trokky v2 CMS",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "cms",
    "express",
    "middleware",
    "http",
    "rest-api"
  ],
  "author": "Trokky Team",
  "license": "MIT",
  "dependencies": {
    "@trokky/core": "file:../../core",
    "@trokky/routes": "file:../../routes",
    "express": "^4.18.2",
    "multer": "^2.0.0"
  },
  "devDependencies": {
    "@trokky/adapter-filesystem": "file:../../adapters/filesystem",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/jest": "^29.5.11",
    "@types/supertest": "^6.0.2",
    "fs-extra": "^11.2.0",
    "@types/fs-extra": "^11.0.4",
    "jest": "^29.7.0",
    "supertest": "^7.1.3",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "express": "^4.18.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  }
}
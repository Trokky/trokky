{
  "name": "trokky-v2",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Modern, composable CMS for developers",
  "workspaces": [
    "packages/trokky",
    "packages/studio",
    "packages/client",
    "examples/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo build --filter=@trokky/trokky --filter=@trokky/studio && npm run dev --workspace=@trokky/demo",
    "dev:packages": "turbo dev",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "clean": "turbo clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only",
    "release": "turbo build && changeset publish",
    "install-hooks": "node scripts/install-git-hooks.js"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.29.5",
    "@types/node": "^20.11.17",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5",
    "turbo": "^2.6.3",
    "typescript": "^5.3.3"
  },
  "packageManager": "npm@10.2.4",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "node-fetch": "^3.3.2"
  }
}
